#!/bin/sh
# Restart the patterns of the RGB status LEDs at the same moment, so a light made of
# several channels (white breathing) keeps its colours together.
#
# /etc/init.d/led starts the LEDs one after another and calls the pattern hook once per
# LED. Every call lands here; only the last one acts, a second after it started.
# With fewer than two RGB channels on a pattern there is nothing to line up.

LEDDIR=${LEDDIR:-/sys/class/leds}
STAMP=${STAMP:-/var/run/led-pattern-sync}

echo $$ > "$STAMP"
sleep 1
[ "$(cat "$STAMP" 2>/dev/null)" = "$$" ] || exit 0

cd "$LEDDIR" || exit 1
n=0
for c in red green blue; do
	eval "P_$c="
	grep -q '\[pattern\]' "$c:status/trigger" 2>/dev/null || continue
	eval "P_$c=\"\$(cat $c:status/pattern 2>/dev/null)\""
	n=$((n + 1))
done
[ "$n" -ge 2 ] || exit 0

# stop them, park each at the first brightness of its pattern, then start them back to back
for c in red green blue; do
	eval "p=\$P_$c"; [ -n "$p" ] || continue
	echo none > "$c:status/trigger"
	echo "$(echo $p | awk '{print $1}')" > "$c:status/brightness"
done
for c in red green blue; do eval "p=\$P_$c"; [ -n "$p" ] && echo pattern > "$c:status/trigger"; done
for c in red green blue; do eval "p=\$P_$c"; [ -n "$p" ] && echo "$p" > "$c:status/pattern"; done
exit 0
