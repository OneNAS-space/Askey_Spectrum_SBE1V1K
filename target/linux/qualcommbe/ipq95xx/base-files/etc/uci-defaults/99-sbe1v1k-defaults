#!/bin/sh
# SBE1V1K defaults, applied once per device (marker kept in /etc/config/system
# so a later choice by the user survives sysupgrade). Runs after
# 99-default-settings, which enables packet steering.

# Packet steering makes ath12k drop clients under heavy load (OpenWrt forum
# thread 245244, post 243).
uci -q get system.sbe1v1k_init >/dev/null || uci -q set system.sbe1v1k_init='sbe1v1k_init'
if [ "$(uci -q get system.sbe1v1k_init.sbe1v1k_packet_steering)" != "0" ]; then
	uci -q set network.@globals[0].packet_steering='0'
	uci -q set system.sbe1v1k_init.sbe1v1k_packet_steering='0'
fi

# Top status LED: slow blue breathing via the "pattern" trigger (hook in
# /usr/libexec/led-trigger/pattern). Only added when no led section already
# drives one of the status LEDs, so an existing red/green/blue configuration
# is never overridden or duplicated.
if [ "$(uci -q get system.sbe1v1k_init.led_breathing)" != "1" ]; then
	have_led=0
	for s in $(uci -q show system | sed -n 's/^system\.\([^.]*\)=led$/\1/p'); do
		case "$(uci -q get system.$s.sysfs)" in
		red:status|green:status|blue:status) have_led=1 ;;
		esac
	done
	if [ "$have_led" = 0 ]; then
		uci -q set system.sbe1v1k_status_led='led'
		uci -q set system.sbe1v1k_status_led.name='status breathing'
		uci -q set system.sbe1v1k_status_led.sysfs='blue:status'
		uci -q set system.sbe1v1k_status_led.trigger='pattern'
		uci -q set system.sbe1v1k_status_led.pattern='0 1500 255 1500'
	fi
	uci -q set system.sbe1v1k_init.led_breathing='1'
fi

# The three radios share one wiphy, so only one of them can scan at a time.
# The 20/40 MHz coexistence scan on 5/6 GHz retries -EBUSY for 15 s and then
# brings the AP up at 20 MHz. Skip that scan on 5/6 GHz (it has no effect on
# channel selection there in practice).
# On a fresh install /etc/config/wireless is only written after the radios
# probe, so it may not exist yet: keep this script (non-zero exit) and retry
# on the next boot.
retry=0

if [ "$(uci -q get system.sbe1v1k_init.noscan)" != "1" ]; then
	devs=$(uci -q show wireless | sed -n "s/^wireless\.\([^.]*\)=wifi-device$/\1/p")
	if [ -z "$devs" ]; then
		retry=1
	else
		for dev in $devs; do
			case "$(uci -q get wireless.$dev.band)" in
			5g|6g)
				uci -q get wireless.$dev.noscan >/dev/null ||
					uci -q set wireless.$dev.noscan='1'
				;;
			esac
		done
		uci -q set system.sbe1v1k_init.noscan='1'
	fi
fi

uci -q commit network
uci -q commit system
uci -q commit wireless

exit $retry
